# Program Description:
# This program welcomes user and facilitates telemetry data retrieval from Sense
# HAT and returns collected environmental data to MQTT broker via json file.

# Import libraries
import time, pathlib, os
from datetime import datetime

from sense_hat import SenseHat
import json

# Define colours
GREEN = (0,255,0)
BLUE = (0,0,255)
RED = (255,0,0)

# Initialise Sense HAT
sense = SenseHat()
sense.clear()
deviceID = "rpi-01"

# Greeting
sense.show_message(
	"Hello!",
	scroll_speed=0.05,
	text_colour=GREEN
)

# Line 28 Function to retrieve sensor data
def get_env_data():

	# Read sensor data
	temp = sense.get_temperature()
	humdty = sense.get_humidity()

	# Determine state
	if temp > 25 or humdty > 70:
		state = "WARNING"

	elif temp < 18 or humdty < 40:
		state = "LOW"

	else:
		state = "OK"

	# Create a dictionary
	data = {
		"deviceID": deviceID,
		"temp": round(temp, 2),
		"humidity": round(humdty, 2),
		"state": state
	}

	return data

# Note: Temperature readings may be influenced by Raspberry Pi CPU heat

# Line 57 Main Loop
while True:

	# Get readings
	data = get_env_data()

	deviceID = data["deviceID"]
	temp = data["temp"]
	humdty = data["humidity"]
	state = data["state"]

	# Print to command line
	print(
		"Temperature: {:.1f} C Humidity: {:.1f} % | State: {}"
		.format(temp, humdty, state)
	)

	# LED colour logic
	if temp > 25 or humdty > 70:
	      	colour = RED

	elif temp < 18 or humdty < 40:
        	colour = BLUE

	else:
		colour = GREEN

	# Display temperature:
	sense.show_message(
		"Temp:{:.1f}C".format(temp),
		text_colour=colour,
		scroll_speed=0.05
	)

	# Display Humidity:
	sense.show_message(
		"Humdty:{:.1f}%".format(humdty),
		text_colour=colour,
		scroll_speed=0.05
	)

	# Delay before next reading
	time.sleep(2)

# Line 101 client.publish(topic, json_data)
