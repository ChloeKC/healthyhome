# Program Description:
# This program welcomes user and facilitates telemetry data retrieval from Sense
# HAT and returns collected environmental data to MQTT broker via json file.

# Import libraries
from sense_hat import SenseHat
import time

# Define colours
GREEN = (0,255,0)
BLUE = (0,0,255)
RED = (255,0,0)

# Initialise Sense HAT
sense = SenseHat()
sense.clear()

# User greeting
sense.show_message(
	"Hello!",
	scroll_speed=0.05,
	text_colour=GREEN
)

# Create function that returns sensor data
def get_env_data():

	# Read sensor data
	temp = sense.get_temperature()
	humdty = sense.get_humidity()

	# Determine state
	if temp > 25 or humdty > 70:
		state = "WARNING"

	elif temp < 16 or humdty < 40:
		state = "LOW"

	else :
		state = "OK"

	# Create dictionary
	data = {
		"deviceID": deviceID,
		"temp": round(temp, 2),
		"humidity": round(humdty, 2),
		"state": state
	}

	return data

# Temperature readings may be influenced by Raspberry Pi CPU heat

while True:

	# Get readings
	data = get_env_data()

	# Print to command line
	print(
		"Temperature: {:.1f} C Humidity: {:.1f} %"
		.format(data)
	)

	# Display LED colour logic
	if temp > 25 or humdty > 70:
		colour = RED
	elif temp < 18 or humdty < 40:
		colour = BLUE
	else:
		colour = GREEN

	# Display temperature:
	sense.show_message(
		"T:{:.1f}C".format(temp),
		text_colour=RED,
		scroll_speed=0.05
	)

	# Display Humidity:
	sense.show_message(
		"H:{:.1f}%".format(humdty),
		text_colour=BLUE,
		scroll_speed=0.05
	)

	# Delay before next reading
	time.sleep(2)

